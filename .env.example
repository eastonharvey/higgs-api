# Copy to .env.local and fill in. .env.local is gitignored.
# Format is key-id:key-secret exactly as shown in the Higgsfield console.
HF_KEY=
# Public HTTPS URL of the running webhook receiver (hf_pipeline.webhook), path /webhooks/higgsfield
HF_WEBHOOK_URL=
# Max simultaneous submissions; keep at or below your account concurrency limit shown in the console
HF_CONCURRENCY=2
# Where downloaded outputs, the registry, and cost_ledger.csv go
OUTPUT_DIR=./output
